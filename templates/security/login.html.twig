{% extends 'base.html.twig' %}

{% block title %}Bienvenue | GENIUS{% endblock %}

{% block body %}
<body class="d-flex align-items-center min-h-100">
  <header class="position-absolute top-0 start-0 end-0 mt-3 mx-3">
    <div class="d-flex d-lg-none justify-content-between">
      <a>
        <img class="w-100" src="{{ asset('assets/svg/logos/logo.svg') }}"
             alt="Genius Logo" style="min-width: 7rem; max-width: 7rem;">
      </a>
    </div>
  </header>

  <main id="content" role="main" class="main pt-0">
    <div class="container-fluid px-3">
      <div class="row">
        <!-- Colonne gauche -->
        <div class="col-lg-6 d-none d-lg-flex justify-content-center align-items-center min-vh-lg-100 position-relative bg-light px-0">
          {% include 'security/_left.html.twig' %}
        </div>

        <!-- Colonne droite (formulaire de connexion) -->
        <div class="col-lg-6 d-flex justify-content-center align-items-center min-vh-lg-100 bg-white">
          {% include 'security/_login_form.html.twig' %}
        </div>
      </div>
    </div>
  </main>
</body>
{% endblock %}
