# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://symfony:symfony@db:3306/symfony?serverVersion=8.0&charset=utf8mb4"

# avant (probablement)
# DATABASE_URL="postgresql://symfony:secret@127.0.0.1:5432/portail?serverVersion=15&charset=utf8"

# après – hôte = nom de service docker‑compose
# DATABASE_URL="postgresql://symfony:secret@symfony_db:5432/portail?serverVersion=15&charset=utf8"

# .env.local  – ce fichier écrase ce qu’il y a dans .env
DATABASE_URL="postgresql://symfony:symfony@db:5432/symfony?serverVersion=15&charset=utf8"

###< doctrine/doctrine-bundle ###

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=symfony
